MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nirvana
MYSQL_USER=nirvana_app
MYSQL_PASSWORD=replace-with-a-local-password

# Create PhonePe PG credentials in the PhonePe Business dashboard.
# Keep the secret only in .env; never commit or share it.
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_ENV=SANDBOX
PUBLIC_BASE_URL=http://127.0.0.1:5000
